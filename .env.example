# Copy to `.env` (which is git-ignored) and fill in.
# docker compose auto-loads .env for variable substitution.

# --- Cloudflare Tunnel (optional remote access) ---
# Token from the Cloudflare Zero Trust dashboard:
#   Networks → Tunnels → Create a tunnel → (copy the token from the Docker tab).
# Then start the tunnel container with:
#   docker compose --profile cloudflare up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: set this so plain `docker compose up -d` (and scripts/deploy.sh) always
# include the cloudflared tunnel, without passing --profile cloudflare each time.
# COMPOSE_PROFILES=cloudflare

# --- Library: private trackers (optional) ---
# Hostnames treated as private when qBittorrent itself can't tell (older than
# 4.5). qBittorrent 5.x reports it per torrent, so this is only a fallback.
# PRIVATE_TRACKERS=portugas.org,example-private.tld
